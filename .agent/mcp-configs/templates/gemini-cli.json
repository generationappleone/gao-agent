{
    "_comment": [
        "GAO Agent — Context7 MCP Config for Gemini CLI",
        "",
        "Setup:",
        "  1. Open/create ~/.gemini/settings.json",
        "  2. Merge the mcpServers section into your existing config",
        "  3. Replace YOUR_API_KEY with your key from https://context7.com/dashboard",
        "  4. Restart Gemini CLI to activate",
        "",
        "Docs: https://google-gemini.github.io/gemini-cli/docs/tools/mcp-server.html",
        "Context7: https://context7.com/docs/resources/all-clients"
    ],
    "mcpServers": {
        "context7": {
            "httpUrl": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "YOUR_API_KEY",
                "Accept": "application/json, text/event-stream"
            }
        }
    }
}