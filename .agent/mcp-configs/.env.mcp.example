# ============================================
# GAO Agent — MCP Server API Keys
# ============================================
#
# INSTRUCTIONS:
#   1. Copy this file to your project root as .env (or .env.local)
#   2. Fill in the API keys for the MCP servers you want to use
#   3. NEVER commit .env files to Git!
#
# Add to .gitignore:
#   .env
#   .env.local
#   .env.*.local
#
# ============================================

# ------------------------------------------
# Context7 — Up-to-date library documentation
# Get free key: https://context7.com/dashboard
# ------------------------------------------
CONTEXT7_API_KEY=

# ------------------------------------------
# GitHub — Repository, issues, PRs, Actions
# Create token: https://github.com/settings/tokens
# ------------------------------------------
# GITHUB_TOKEN=

# ------------------------------------------
# Supabase — Database, Auth, Storage
# Get key: https://supabase.com/dashboard
# ------------------------------------------
# SUPABASE_ACCESS_TOKEN=

# ------------------------------------------
# Sentry — Error tracking & performance
# Get token: https://sentry.io/settings/auth-tokens/
# ------------------------------------------
# SENTRY_AUTH_TOKEN=

# ------------------------------------------
# Stripe — Payment processing
# Get key: https://dashboard.stripe.com/apikeys
# ------------------------------------------
# STRIPE_API_KEY=

# ------------------------------------------
# Notion — Pages, databases, knowledge base
# Create integration: https://www.notion.so/my-integrations
# ------------------------------------------
# NOTION_API_KEY=

# ------------------------------------------
# Vercel — Deployments, projects, domains
# Create token: https://vercel.com/account/tokens
# ------------------------------------------
# VERCEL_TOKEN=

# ------------------------------------------
# Figma — Design files, components, tokens
# Create token: https://www.figma.com/developers/api
# ------------------------------------------
# FIGMA_ACCESS_TOKEN=

# ------------------------------------------
# Snyk — Vulnerability scanning
# Get token: https://app.snyk.io/account
# ------------------------------------------
# SNYK_TOKEN=

# ------------------------------------------
# Datadog — APM, monitoring
# Get key: https://app.datadoghq.com/organization-settings/api-keys
# ------------------------------------------
# DD_API_KEY=
# DD_APP_KEY=

# ------------------------------------------
# PagerDuty — Incident management
# Get key: https://support.pagerduty.com/docs/api-access-keys
# ------------------------------------------
# PAGERDUTY_API_KEY=

# ------------------------------------------
# Neon — Serverless PostgreSQL
# Get key: https://console.neon.tech/app/settings/api-keys
# ------------------------------------------
# NEON_API_KEY=

# ------------------------------------------
# Atlassian (Jira/Confluence)
# Create token: https://id.atlassian.com/manage-profile/security/api-tokens
# ------------------------------------------
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_SITE_URL=

# ------------------------------------------
# Azure — Cloud services
# ------------------------------------------
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=

# ------------------------------------------
# Firecrawl — Web scraping
# Get key: https://firecrawl.dev
# ------------------------------------------
# FIRECRAWL_API_KEY=

# ------------------------------------------
# Tavily — AI web search
# Get key: https://tavily.com
# ------------------------------------------
# TAVILY_API_KEY=
